{
  "name": "match-count-down",
  "version": "1.0.0",
  "description": "A modern web application for displaying match timers and scoreboards for various sports",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspaces",
    "install:all": "npm install && npm install --workspace=frontend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
} 